#!/usr/bin/env bash
set -uo pipefail

BIN_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
CORE="$BIN_DIR/ask_core.py"

# ask_core.py needs the `playwright` package. Prefer an explicit CHATGPT_PYTHON, then the
# system python3 when it can import playwright, then the isolated venv that
# `uv tool install playwright` creates (PEP 668 hosts such as Debian/Ubuntu refuse a
# plain `pip install`). Falls back to python3 so ask_core reports the missing package.
uv_bin() {
  if command -v uv >/dev/null 2>&1; then
    command -v uv
  elif [[ -x "$HOME/.local/bin/uv" ]]; then
    printf '%s\n' "$HOME/.local/bin/uv"
  else
    return 1
  fi
}

resolve_python() {
  local candidate uv
  if [[ -n "${CHATGPT_PYTHON:-}" ]]; then
    printf '%s\n' "$CHATGPT_PYTHON"
    return 0
  fi
  if python3 -c 'import playwright' >/dev/null 2>&1; then
    printf 'python3\n'
    return 0
  fi
  if uv="$(uv_bin)"; then
    candidate="$("$uv" tool dir 2>/dev/null)/playwright/bin/python"
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  printf 'python3\n'
}
PYTHON="$(resolve_python)"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  exec "$PYTHON" "$CORE" "$@"
fi

if ((BASH_VERSINFO[0] < 5)); then
  echo "chatgpt: bash >= 5 is required (found $BASH_VERSION; on macOS: brew install bash)" >&2
  exit 1
fi

OS_NAME="$(uname -s)"

STATE_DIR="$HOME/.chatgpt"
STATE="$STATE_DIR/stack.env"
PROFILE="${CHATGPT_PROFILE:-$HOME/.chatgpt/browser-profile}"
CDP_PORT="${CHATGPT_CDP_PORT:-9222}"
NOVNC_PORT="${CHATGPT_NOVNC_PORT:-6080}"
LOCK_WAIT="${CHATGPT_LOCK_WAIT:-3600}"
# Internal concurrency override; intentionally not part of the public interface.
MAX_PARALLEL="${CHATGPT_MAX_PARALLEL:-3}"
# CHATGPT_STACK_ONLY=1: bring up (or reuse) the VNC/Chrome/noVNC stack and exit 0 without
# submitting anything. Used by `chatgpt-setup --login` so the user can sign in through noVNC.
STACK_ONLY="${CHATGPT_STACK_ONLY:-0}"
VNCSERVER="${CHATGPT_VNCSERVER:-/opt/TurboVNC/bin/vncserver}"
# VirtualGL puts Chrome's WebGL on a real GPU (Linux). An explicitly empty CHATGPT_VGLRUN opts
# out, hence `-` rather than `:-`.
VGLRUN="${CHATGPT_VGLRUN-/opt/VirtualGL/bin/vglrun}"
if [[ "$OS_NAME" == "Darwin" ]]; then
  CHROME_BIN="${CHATGPT_CHROME_BIN:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
else
  CHROME_BIN="${CHATGPT_CHROME_BIN:-/usr/bin/google-chrome}"
fi

chrome_gpu_mode() {
  if [[ -n "$VGLRUN" && -x "$VGLRUN" ]] && nvidia-smi -L >/dev/null 2>&1; then
    printf 'virtualgl\n'
  else
    printf 'software\n'
  fi
}

mkdir -p "$STATE_DIR" "$STATE_DIR/out" "$STATE_DIR/slots"

if ! command -v flock >/dev/null 2>&1; then
  echo "chatgpt: flock is required" >&2
  exit 1
fi

if [[ ! "$MAX_PARALLEL" =~ ^[1-9][0-9]*$ ]]; then
  echo "chatgpt: CHATGPT_MAX_PARALLEL must be a positive integer" >&2
  exit 64
fi
if [[ ! "$LOCK_WAIT" =~ ^[0-9]+$ ]]; then
  echo "chatgpt: CHATGPT_LOCK_WAIT must be a non-negative integer" >&2
  exit 64
fi

SLOT_FD=
SLOT_LOCK=
acquire_slot() {
  local candidate_fd index
  for ((index = 0; index < MAX_PARALLEL; index++)); do
    exec {candidate_fd}>"$STATE_DIR/slots/slot${index}.lock"
    if flock -n "$candidate_fd"; then
      SLOT_FD="$candidate_fd"
      SLOT_LOCK="$STATE_DIR/slots/slot${index}.lock"
      return 0
    fi
    exec {candidate_fd}>&-
  done
  return 1
}

if ! acquire_slot; then
  if [[ "$LOCK_WAIT" == "0" ]]; then
    echo "chatgpt: all ${MAX_PARALLEL} run slots are busy" >&2
    exit 4
  fi
  echo "chatgpt: waiting for a free run slot (up to ${LOCK_WAIT}s)" >&2
  slot_deadline_us=$((${EPOCHREALTIME/./} + LOCK_WAIT * 1000000))
  while ((${EPOCHREALTIME/./} < slot_deadline_us)); do
    sleep 0.1
    acquire_slot && break
  done
  if [[ -z "$SLOT_FD" ]]; then
    echo "chatgpt: slot wait timed out after ${LOCK_WAIT}s" >&2
    exit 4
  fi
fi

LOCK_OWNER="pid=$$ cwd=$PWD started=$(date +%Y-%m-%dT%H:%M:%S%z)"
SLOT_INFO="$SLOT_LOCK.info"
printf '%s\n' "$LOCK_OWNER" > "$SLOT_INFO"

# Trailing Xs keep BSD mktemp (macOS) happy; GNU accepts this form too.
RESPONSE_LOG="$(mktemp "$STATE_DIR/output.log.XXXXXX")"
cleanup() {
  local info
  for info in "$SLOT_INFO" "${RUN_LOCK_INFO:-}"; do
    if [[ -n "$info" ]] && [[ "$(sed -n '1p' "$info" 2>/dev/null || true)" == "$LOCK_OWNER" ]]; then
      rm -f "$info"
    fi
  done
  rm -f "$RESPONSE_LOG"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

RUN_LOCK="$STATE_DIR/run.lock"
RUN_LOCK_INFO="$RUN_LOCK.info"
exec {RUN_FD}>"$RUN_LOCK"
if ! flock -n "$RUN_FD"; then
  holder="$(sed -n '1p' "$RUN_LOCK_INFO" 2>/dev/null || true)"
  if [[ "$LOCK_WAIT" == "0" ]]; then
    echo "chatgpt: another submit holds the lock${holder:+ ($holder)}" >&2
    exit 4
  fi
  echo "chatgpt: waiting for the active submit (up to ${LOCK_WAIT}s)${holder:+; $holder}" >&2
  if ! flock -w "$LOCK_WAIT" "$RUN_FD"; then
    echo "chatgpt: submit lock wait timed out after ${LOCK_WAIT}s" >&2
    exit 4
  fi
fi
printf '%s\n' "$LOCK_OWNER" > "$RUN_LOCK_INFO"

# Rate limiter: ChatGPT throttles rapid successive requests from one account
# ("too many requests" access block observed 2026-08-13 with 3-way parallel
# submits). Enforce a minimum randomized gap between consecutive submits,
# measured from the previous submit timestamp (persisted across invocations).
# Tunables (undocumented on purpose): CHATGPT_SUBMIT_GAP_MIN/MAX seconds.
GAP_MIN="${CHATGPT_SUBMIT_GAP_MIN:-8}"
GAP_MAX="${CHATGPT_SUBMIT_GAP_MAX:-20}"
STAMP="$STATE_DIR/last_submit"
if [[ "$STACK_ONLY" != "1" ]]; then
  now=$(date +%s)
  last=$(cat "$STAMP" 2>/dev/null || echo 0)
  gap=$(( GAP_MIN + RANDOM % (GAP_MAX - GAP_MIN + 1) ))
  elapsed=$(( now - last ))
  if (( elapsed < gap )); then
    wait_s=$(( gap - elapsed ))
    echo "chatgpt: rate limiter — sleeping ${wait_s}s before submit" >&2
    sleep "$wait_s"
  fi
  date +%s > "$STAMP"
fi

# Stack daemons must not outlive the invocation with either lock FD inherited.
# The fork must happen AFTER the closes, so this helper backgrounds internally and
# call sites must not append `&`. Measured (0.2.0, macOS): `without_locks … &` with
# a subshell-body function made bash fork an outer background shell that never ran
# the closes and waited on Chrome holding both locks for Chrome's whole life —
# every later run then blocked on the submit lock until LOCK_WAIT. The inner
# `exec "$@"` leaves no intermediate shell between the wrapper and the daemon.
spawn_unlocked() {
  ( exec {SLOT_FD}>&- {RUN_FD}>&-
    exec "$@"
  ) &
}

port_open() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
  else
    ss -ltn 2>/dev/null | grep -q "127.0.0.1:$1 "
  fi
}

cdp_up() {
  curl -sf --max-time 3 "http://127.0.0.1:$CDP_PORT/json/version" \
    | grep -Eq '"Browser"[[:space:]]*:[[:space:]]*"(Chrome|Chromium|HeadlessChrome|Edg|Comet)'
}

display_port() {
  echo $((5900 + ${1#:}))
}

my_vnc_display() {
  local pid args display
  for pid in $(pgrep -u "$(id -u)" -x Xvnc 2>/dev/null); do
    args="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
    display="$(printf '%s\n' "$args" | grep -oE '(^|[[:space:]])(:[0-9]+)' | head -1 | tr -d ' ')"
    if [[ -n "$display" ]] && port_open "$(display_port "$display")"; then
      printf '%s\n' "$display"
      return 0
    fi
  done
  return 1
}

pick_free_display() {
  local n
  for n in $(seq 2 20); do
    [[ -e "/tmp/.X11-unix/X$n" ]] && continue
    port_open "$((5900 + n))" && continue
    printf ':%s\n' "$n"
    return 0
  done
  return 1
}

read_display_from_state() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  sed -n 's/^VNC_DISPLAY=\(:[0-9][0-9]*\)$/\1/p' "$file" | head -1
}

start_vnc() {
  local display
  display="$(my_vnc_display || true)"
  if [[ -n "$display" ]]; then
    VNC_DISPLAY="$display"
    echo "chatgpt: reusing VNC $VNC_DISPLAY" >&2
    return 0
  fi
  display="$(pick_free_display || true)"
  if [[ -z "$display" ]]; then
    echo "chatgpt: no free VNC display in :2..:20" >&2
    return 1
  fi
  if [[ ! -x "$VNCSERVER" ]]; then
    echo "chatgpt: TurboVNC server not found at $VNCSERVER" >&2
    return 1
  fi
  spawn_unlocked "$VNCSERVER" "$display" -geometry 1600x1000 -depth 24 \
    -securitytypes otp -interface 127.0.0.1 -wm openbox >/dev/null 2>&1
  sleep 2
  if ! port_open "$(display_port "$display")"; then
    echo "chatgpt: VNC startup failed; inspect $HOME/.vnc" >&2
    return 1
  fi
  VNC_DISPLAY="$display"
  echo "chatgpt: started VNC $VNC_DISPLAY" >&2
}

start_chrome() {
  local attempt
  cdp_up && return 0
  if [[ ! -x "$CHROME_BIN" ]]; then
    echo "chatgpt: Chrome binary is unavailable: $CHROME_BIN" >&2
    return 1
  fi
  if [[ ! -d "$PROFILE" ]]; then
    if [[ "$OS_NAME" == "Darwin" ]]; then
      # First run on a Mac: create the dedicated profile and let the user log in
      # to chatgpt.com in the window that opens. Keeping a dedicated
      # --user-data-dir matters — Chrome 136+ refuses CDP on the default profile.
      echo "chatgpt: creating browser profile $PROFILE — log in to chatgpt.com in the Chrome window, then re-run" >&2
      mkdir -p "$PROFILE"
    else
      echo "chatgpt: logged-in browser profile is missing: $PROFILE" >&2
      return 1
    fi
  fi
  pkill -f -- "user-data-dir=$PROFILE" 2>/dev/null || true
  sleep 2
  # On macOS the window opens on the real desktop; DISPLAY is a Linux/VNC concept.
  # Xvnc has no GPU, and OpenAI's sentinel bot check needs WebGL. Measured on a headless
  # Ubuntu 24.04 host (Chrome 152): with no WebGL the login "Continue" spinner hangs with
  # zero network traffic; with software WebGL (SwiftShader) it still hangs — the renderer
  # name itself reads as headless; on a real GPU through VirtualGL's EGL back end the login
  # goes through. VirtualGL needs no X server on the GPU, but Chrome's GPU sandbox blocks
  # its X connection, hence --disable-gpu-sandbox. Without VirtualGL fall back to software
  # WebGL (--enable-unsafe-swiftshader is required since ~M131) and say so.
  local -a display_env=() gl_prefix=() gpu_flags=()
  local gpu_mode=""
  if [[ "$OS_NAME" != "Darwin" ]]; then
    display_env=(env "DISPLAY=$VNC_DISPLAY")
    if [[ "$CHROME_GPU" == "virtualgl" ]]; then
      gl_prefix=("$VGLRUN" -d egl)
      gpu_flags=(--ignore-gpu-blocklist --disable-gpu-sandbox)
      gpu_mode=" (GPU via VirtualGL)"
    else
      gpu_flags=(--enable-unsafe-swiftshader --use-angle=swiftshader)
      gpu_mode=" (software WebGL — no VirtualGL)"
    fi
  fi
  spawn_unlocked "${display_env[@]}" nohup "${gl_prefix[@]}" "$CHROME_BIN" \
    --remote-debugging-port="$CDP_PORT" \
    --user-data-dir="$PROFILE" \
    --no-first-run --no-default-browser-check --disable-dev-shm-usage \
    "${gpu_flags[@]}" \
    --window-size=1580,960 https://chatgpt.com \
    > "$STATE_DIR/chrome.log" 2>&1
  for attempt in $(seq 1 20); do
    if cdp_up; then
      echo "chatgpt: started Chrome CDP $CDP_PORT$gpu_mode" >&2
      return 0
    fi
    sleep 1
  done
  echo "chatgpt: Chrome CDP startup failed; inspect $STATE_DIR/chrome.log" >&2
  return 1
}

start_novnc() {
  if port_open "$NOVNC_PORT"; then
    return 0
  fi
  if ! command -v websockify >/dev/null 2>&1; then
    echo "chatgpt: websockify is unavailable" >&2
    return 1
  fi
  spawn_unlocked nohup websockify --web=/usr/share/novnc "127.0.0.1:$NOVNC_PORT" \
    "127.0.0.1:$(display_port "$VNC_DISPLAY")" > "$STATE_DIR/novnc.log" 2>&1
  sleep 2
  if ! port_open "$NOVNC_PORT"; then
    echo "chatgpt: noVNC startup failed; inspect $STATE_DIR/novnc.log" >&2
    return 1
  fi
  echo "chatgpt: started noVNC $NOVNC_PORT" >&2
}

if [[ "$OS_NAME" == "Darwin" ]]; then
  # macOS runs headful on the real desktop: no VNC, no noVNC. The Chrome window
  # itself is the observation surface that noVNC provides on headless Linux.
  if cdp_up; then
    echo "chatgpt: reusing Chrome CDP $CDP_PORT" >&2
  else
    start_chrome || exit 1
  fi
  {
    echo "# Generated by chatgpt; do not edit while the stack is running."
    echo "CDP_PORT=$CDP_PORT"
  } > "$STATE"
else
  CHROME_GPU="$(sed -n -e 's/^CHROME_GPU=virtualgl$/virtualgl/p' \
    -e 's/^CHROME_GPU=software$/software/p' "$STATE" 2>/dev/null | head -1)"
  DESIRED_CHROME_GPU="$(chrome_gpu_mode)"
  VNC_DISPLAY="$(read_display_from_state "$STATE" || true)"
  if [[ -z "$VNC_DISPLAY" ]]; then
    VNC_DISPLAY="$(my_vnc_display || true)"
  fi

  if cdp_up; then
    echo "chatgpt: reusing Chrome CDP $CDP_PORT" >&2
  else
    CHROME_GPU="$DESIRED_CHROME_GPU"
    start_vnc || exit 1
    start_chrome || exit 1
  fi

  if [[ -z "$VNC_DISPLAY" ]]; then
    VNC_DISPLAY="$(my_vnc_display || true)"
  fi
  if [[ -z "$VNC_DISPLAY" ]]; then
    echo "chatgpt: could not determine the VNC display" >&2
    exit 1
  fi
  export DISPLAY="$VNC_DISPLAY"

  start_novnc || exit 1
  {
    echo "# Generated by chatgpt; do not edit while the stack is running."
    echo "VNC_DISPLAY=$VNC_DISPLAY"
    echo "NOVNC_PORT=$NOVNC_PORT"
    echo "CDP_PORT=$CDP_PORT"
    [[ -n "$CHROME_GPU" ]] && echo "CHROME_GPU=$CHROME_GPU"
  } > "$STATE"
fi

if [[ "$STACK_ONLY" == "1" ]]; then
  echo "chatgpt: stack ready (state in $STATE)" >&2
  exit 0
fi

CHATGPT_CDP_PORT="$CDP_PORT" \
CHATGPT_SUBMIT_LOCK_FD="$RUN_FD" \
CHATGPT_SUBMIT_LOCK_INFO="$RUN_LOCK_INFO" \
  "$PYTHON" "$CORE" "$@" > "$RESPONSE_LOG"
rc=$?
cat "$RESPONSE_LOG"
exit "$rc"
